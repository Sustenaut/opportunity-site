{
  "uses": [
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        "with-secrets",
        "with-secrets.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.app-token",
      "paths": [
        "k8s/app.yaml",
        "opportunity/github.py",
        "push-secrets.sh"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.edit-pr",
      "paths": [
        "opportunity/github.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.ghcr",
      "paths": [
        ".github/workflows/deploy.yml",
        "k8s/app.yaml",
        "k8s/kustomization.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "google.cloud",
      "paths": [
        "k8s/backup.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "letsencrypt.certs",
      "paths": [
        "k8s/ingress.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "tailscale.tailnet",
      "paths": [
        ".github/workflows/deploy.yml"
      ],
      "mode": "required"
    }
  ],
  "own_hosts": [
    "sustenaut.eu"
  ],
  "other_secrets": [
    {
      "name": "SUSTENAUT_DEPLOY_SSH_KEY",
      "reason": "An SSH key to our own server"
    }
  ],
  "exclude": [
    {
      "path": "tests/**",
      "reason": "Fakes and test data"
    }
  ]
}
