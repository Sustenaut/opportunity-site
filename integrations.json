{
  "uses": [
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        "with-secrets.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.app-token",
      "paths": [
        "k8s/app.yaml",
        "opportunity/github.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.edit-pr",
      "paths": [
        "opportunity/github.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.ghcr",
      "paths": [
        ".github/workflows/deploy.yml",
        "k8s/app.yaml",
        "k8s/kustomization.yaml",
        "k8s/postgres.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "google.cloud",
      "paths": [
        "k8s/backup.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "letsencrypt.certs",
      "paths": [
        "k8s/ingress.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "storage.api",
      "paths": [
        "opportunity/files.py"
      ],
      "mode": "required"
    }
  ],
  "own_hosts": [
    "sustenaut.eu"
  ],
  "other_secrets": [
    {
      "name": "SUSTENAUT_DEPLOY_SSH_KEY",
      "reason": "An SSH key to our own server"
    }
  ],
  "exclude": [
    {
      "path": "tests/**",
      "reason": "Fakes and test data"
    }
  ],
  "terraform": [
    {
      "dir": "infra",
      "plugins": [
        "terraform.google"
      ],
      "runs": [
        "laptop"
      ],
      "mode": "required"
    }
  ]
}
