{
  "kind": "service",
  "ci": {
    "with": {
      "setup": "python -m venv .venv && .venv/bin/pip install --quiet -r requirements.lock",
      "test": ".venv/bin/python -m pytest -q",
      "shellcheck": "with-secrets *.sh"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "integrations / scan"
    ],
    "tags": false
  }
}
